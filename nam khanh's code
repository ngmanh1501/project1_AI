def aStarSearch(problem: SearchProblem, heuristic=nullHeuristic):  # bài 4
    """Search the node that has the lowest combined cost and heuristic first."""
    "*** YOUR CODE HERE ***"
    hangdoi_ut = util.PriorityQueue()
    trangthai_bandau = problem.getStartState()
    heur_bandau = heuristic(trangthai_bandau, problem)
    hangdoi_ut.push((trangthai_bandau,[]),heur_bandau)
    dacheck = set()
    
    while hangdoi_ut.isEmpty() == False:
            trangthai_hientai, hanhdong = hangdoi_ut.pop()
            if problem.isGoalState(trangthai_hientai):
                return hanhdong
            if trangthai_hientai not in dacheck:
                dacheck.add(trangthai_hientai)
                for trangthai_tiep,buocdi,chiphi in problem.getSuccessors(trangthai_hientai):
                    hanhdong_moi = hanhdong + [buocdi]
                    chiphi_dadi = problem.getCostOfActions(hanhdong_moi)
                    chiphi_toidich = heuristic(trangthai_tiep,problem)
                    tongchiphi = chiphi_dadi + chiphi_toidich
                    hangdoi_ut.push((trangthai_tiep,hanhdong_moi),tongchiphi)
                    hangdoi_ut.push((trangthai_tiep,hanhdong_moi),tongchiphi)
